# ============================================
# RAG 智能问答系统 - 环境变量配置示例
# ============================================

# ----------------------------
# LLM 配置
# ----------------------------

# 通义千问 API Key (必填)
# 申请地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key

# LLM 模型名称
# 可选: qwen-max, qwen-turbo
LLM_MODEL=qwen-max

# 温度参数 (0-1)，值越小回答越确定
TEMPERATURE=0.1

# OpenAI API Key (可选，备用)
# OPENAI_API_KEY=your-openai-api-key

# ----------------------------
# Embedding 配置
# ----------------------------

# Embedding 提供商
# 可选: dashscope, openai, bge
EMBEDDING_PROVIDER=dashscope

# Embedding 模型名称
EMBEDDING_MODEL=text-embedding-v2

# ----------------------------
# 向量库配置
# ----------------------------

# 向量数据库类型
# 可选: chroma, faiss
VECTOR_DB_TYPE=chroma

# 向量库数据存储路径
VECTOR_DB_PATH=./chroma_db

# ----------------------------
# 文档处理配置
# ----------------------------

# 文档目录路径
DOCS_PATH=./docs

# 文档分割大小
CHUNK_SIZE=800

# 文档重叠大小
CHUNK_OVERLAP=100

# ----------------------------
# 检索配置
# ----------------------------

# 返回的相关文档数量
TOP_K=5

# 是否启用重排序
USE_RERANK=false

# ----------------------------
# 缓存配置
# ----------------------------

# 是否启用查询缓存
USE_CACHE=true

# Redis 连接地址 (当使用分布式缓存时)
# REDIS_URL=redis://localhost:6379/0

# ----------------------------
# 日志配置
# ----------------------------

# 日志文件路径
LOG_PATH=./logs

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ----------------------------
# API 服务配置
# ----------------------------

# API 服务监听地址
API_HOST=0.0.0.0

# API 服务监听端口
API_PORT=8000
